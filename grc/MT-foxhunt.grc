options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Midterm fox hunt: receive only. A PlutoSDR Source at 1 MS/s tuned
      250 kHz below 915 MHz, so the Pluto''s DC spike stays off the fox. Spectrum
      and waterfall show the whole 1 MHz around 915 MHz; a Frequency Xlating FIR Filter
      picks out a channel centered on 915 MHz, Channel width wide, and two readouts
      show its power in dBFS: the 100 ms average and the strongest 2 ms in the last
      quarter second, which catches short bursts. The ADC level readout shows the
      largest I or Q sample; at 1.0 the ADC clips, so lower the RX gain. Needs a PlutoSDR
      in extended-frequency mode (70 MHz to 6 GHz). It transmits nothing.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: MT_foxhunt
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Midterm Fox Hunt
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: ch_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate/2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 12]
    rotation: 0
    state: enabled
- name: chan_bw
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,1,1,1
    label: Channel width (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: 50e3
    step: 5e3
    stop: 250e3
    value: 200e3
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 12]
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: ''
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 12]
    rotation: 0
    state: enabled
- name: if_off
  id: variable
  parameters:
    comment: LO sits this far below fc
    value: 250e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 12]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,1
    label: RX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
