- name: dialer
  id: epy_block
  parameters:
    _source_code: "\"\"\"DTMF Dialer: sends `digits` as DTMF tones, then a pause,\
      \ over and over.\n\nEach digit is a row tone and a column tone, `tone_ms` long,\
      \ followed by\n`gap_ms` of silence. The row tone has amplitude `level`; the\
      \ column tone is\n`twist_db` above it (negative: below it). `offset_pct` moves\
      \ every tone by\nthat percentage. Characters other than 0-9, A-D, * and # are\
      \ skipped.\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\nROWS = (697,\
      \ 770, 852, 941)\nCOLS = (1209, 1336, 1477, 1633)\nKEYS = ('123A', '456B', '789C',\
      \ '*0#D')\n\n\nclass blk(gr.sync_block):\n    def __init__(self, samp_rate=8000,\
      \ digits='123', tone_ms=70, gap_ms=70,\n                 pause_ms=500, level=0.3,\
      \ twist_db=0.0, offset_pct=0.0):\n        gr.sync_block.__init__(self, name='DTMF\
      \ Dialer', in_sig=None, out_sig=[np.float32])\n        self.samp_rate, self.digits\
      \ = samp_rate, digits\n        self.tone_ms, self.gap_ms, self.pause_ms = tone_ms,\
      \ gap_ms, pause_ms\n        self.level, self.twist_db, self.offset_pct = level,\
      \ twist_db, offset_pct\n        self.made = None\n        self.pos = 0\n\n \
      \   def make(self):\n        fs = self.samp_rate\n        n_tone = int(round(fs\
      \ * self.tone_ms / 1000))\n        t = np.arange(n_tone) / fs\n        scale\
      \ = 1 + self.offset_pct / 100\n        hi_amp = self.level * 10 ** (self.twist_db\
      \ / 20)\n        parts = []\n        for d in str(self.digits).upper():\n  \
      \          for r, row in enumerate(KEYS):\n                if d in row:\n  \
      \                  c = row.index(d)\n                    parts.append(self.level\
      \ * np.sin(2 * np.pi * ROWS[r] * scale * t)\n                              \
      \   + hi_amp * np.sin(2 * np.pi * COLS[c] * scale * t))\n                  \
      \  parts.append(np.zeros(int(round(fs * self.gap_ms / 1000))))\n        parts.append(np.zeros(int(round(fs\
      \ * self.pause_ms / 1000))))\n        self.wave = np.concatenate(parts).astype(np.float32)\n\
      \n    def work(self, input_items, output_items):\n        now = (self.samp_rate,\
      \ self.digits, self.tone_ms, self.gap_ms, self.pause_ms,\n               self.level,\
      \ self.twist_db, self.offset_pct)\n        if now != self.made:            \
      \        # a setting changed: rebuild the sequence\n            self.make()\n\
      \            self.made = now\n            self.pos = 0\n        out = output_items[0]\n\
      \        n = 0\n        while n < len(out):\n            k = min(len(out) -\
      \ n, len(self.wave) - self.pos)\n            out[n:n + k] = self.wave[self.pos:self.pos\
      \ + k]\n            n += k\n            self.pos = (self.pos + k) % len(self.wave)\n\
      \        return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    digits: number
    gap_ms: gap_ms
    level: level
    maxoutbuf: '1024'
    minoutbuf: '0'
    offset_pct: offset_pct
    pause_ms: '500'
    samp_rate: samp_rate
    tone_ms: tone_ms
    twist_db: twist_db
  states:
    _io_cache: ('DTMF Dialer', 'blk', [('samp_rate', '8000'), ('digits', "'123'"),
      ('tone_ms', '70'), ('gap_ms', '70'), ('pause_ms', '500'), ('level', '0.3'),
      ('twist_db', '0.0'), ('offset_pct', '0.0')], [], [('0', 'float', 1)], '', ['digits',
      'gap_ms', 'level', 'offset_pct', 'pause_ms', 'samp_rate', 'tone_ms', 'twist_db'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [20, 360]
    rotation: 0
    state: enabled
- name: dtmf_decoder
  id: epy_block
  parameters:
    N: N
    _source_code: "\"\"\"DTMF Decoder: a Goertzel bin at each of the eight DTMF frequencies,\
      \ read\nonce per block of N samples, with a new block every N/2 samples.\n\n\
      A block holds a digit when the strongest row bin and the strongest column bin\n\
      carry at least `share` of the block's energy, each is at least 6 dB above the\n\
      other three bins in its group, and the column tone is no more than 6 dB above\n\
      or 10 dB below the row tone. A digit is reported when three blocks in a row\
      \ hold it, and\nagain only after a block that does not.\nA pause of 200 ms or\
      \ more ends a number. The counts start over when a setting\nchanges, and a number\
      \ that is not decoded never counts.\nFunction Probes read digits() and stats()\
      \ for the QT GUI Labels.\"\"\"\n\nimport time\n\nimport numpy as np\nfrom gnuradio\
      \ import gr\n\nROWS = (697, 770, 852, 941)\nCOLS = (1209, 1336, 1477, 1633)\n\
      KEYS = ('123A', '456B', '789C', '*0#D')\n\n\nclass blk(gr.sync_block):\n   \
      \ def __init__(self, samp_rate=8000, N=205, share=0.35, round_k=False,\n   \
      \              expected='', settings=None):\n        gr.sync_block.__init__(self,\
      \ name='DTMF Decoder', in_sig=[np.float32], out_sig=None)\n        self.fs =\
      \ samp_rate\n        self.N = int(N)\n        self.share = share\n        self.round_k\
      \ = round_k\n        self.expected = expected\n        self.settings = settings\n\
      \n    @property\n    def settings(self):\n        return self._settings\n\n\
      \    @settings.setter\n    def settings(self, value):\n        # GRC sets this\
      \ whenever a setting it names changes; start the counts over,\n        # and\
      \ drop the first number after a change, which may mix old and new samples.\n\
      \        self.discard = hasattr(self, '_settings')\n        self._settings =\
      \ value\n        k = np.array(ROWS + COLS) * self.N / self.fs       # bin number\
      \ of each tone\n        if self.round_k:\n            k = np.round(k)\n    \
      \    self.coef = 2 * np.cos(2 * np.pi * k / self.N)\n        self.hop = self.N\
      \ // 2\n        self.buf = np.zeros(0, dtype=np.float32)\n        self.prev\
      \ = self.held = None\n        self.run = 0\n        self.quiet = 0\n       \
      \ self.number = ''\n        self.shown = '(listening)'\n        self.good =\
      \ self.total = 0\n        self.t0 = time.monotonic()\n\n    def goertzel(self,\
      \ x):\n        q1 = np.zeros(8)\n        q2 = np.zeros(8)\n        for v in\
      \ x:\n            q1, q2 = self.coef * q1 - q2 + v, q1\n        return q1 *\
      \ q1 + q2 * q2 - self.coef * q1 * q2      # |X(k)|^2 for each tone\n\n    def\
      \ decide(self, x):\n        energy = np.dot(x, x)\n        if energy < 1e-8:\n\
      \            return None\n        p = self.goertzel(x) * 2 / (self.N * energy)\
      \          # a lone tone gives 1\n        lo, hi = p[:4], p[4:]\n        r,\
      \ c = int(np.argmax(lo)), int(np.argmax(hi))\n        if lo[r] + hi[c] < self.share:\n\
      \            return None                                       # not enough\
      \ energy in two tones\n        if np.sort(lo)[-2] * 4 > lo[r] or np.sort(hi)[-2]\
      \ * 4 > hi[c]:\n            return None                                    \
      \   # no clear winner (6 dB)\n        if hi[c] > lo[r] * 10 ** 0.6 or lo[r]\
      \ > hi[c] * 10 ** 1.0:\n            return None                            \
      \           # twist: +6 dB / -10 dB\n        return KEYS[r][c]\n\n    def work(self,\
      \ input_items, output_items):\n        self.buf = np.concatenate((self.buf,\
      \ input_items[0]))\n        while len(self.buf) >= self.N:\n            d =\
      \ self.decide(self.buf[:self.N].astype(np.float64))\n            self.buf =\
      \ self.buf[self.hop:]\n            self.run = self.run + 1 if d is not None\
      \ and d == self.prev else int(d is not None)\n            if d != self.held:\n\
      \                self.held = None\n            if d is not None and self.run\
      \ >= 3 and self.held is None:\n                self.number += d\n          \
      \      self.held = d\n            self.quiet = 0 if d is not None else self.quiet\
      \ + 1\n            if self.number and self.quiet * self.hop >= 0.2 * self.fs:\n\
      \                self.finish()\n            self.prev = d\n        return len(input_items[0])\n\
      \n    def finish(self):\n        if self.discard:\n            self.discard\
      \ = False\n        else:\n            self.shown = self.number\n           \
      \ self.total += 1\n            self.good += self.number == str(self.expected).upper()\n\
      \        self.number = ''\n\n    def digits(self):\n        return self.number\
      \ or self.shown\n\n    def stats(self):\n        t = time.monotonic() - self.t0\n\
      \        if not self.expected:\n            return f'{self.total} decoded in\
      \ {t:.0f} s'\n        return f'{self.good} correct of {self.total} decoded in\
      \ {t:.0f} s'\n"
    affinity: ''
    alias: ''
    comment: ''
    expected: number
    maxoutbuf: '0'
    minoutbuf: '0'
    round_k: 'False'
    samp_rate: samp_rate
    settings: (number, snr_db, twist_db, tone_ms, gap_ms, offset_pct)
    share: '0.35'
  states:
    _io_cache: ('DTMF Decoder', 'blk', [('samp_rate', '8000'), ('N', '205'), ('share',
      '0.35'), ('round_k', 'False'), ('expected', "''"), ('settings', 'None')], [('0',
      'float', 1)], [], '', ['N', 'expected', 'round_k', 'settings', 'share'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 380]
    rotation: 0
    state: enabled
