    comment: ''
    freq: station_mhz * 1e6
    gui_hint: 3,1,1,3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 850]
    rotation: 0
    state: enabled
- name: rds_parser
