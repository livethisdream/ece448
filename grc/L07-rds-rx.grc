    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    pty_locale: '1'
    reset: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 840]
    rotation: 0
    state: enabled
- name: rds_shift
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: 57e3
    comment: ''
    decim: '10'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate / 10
    taps: firdes.low_pass(1.0, samp_rate / 10, 7.5e3, 5e3)
    type: fcc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [300, 640]
    rotation: 0
    state: enabled
- name: rf_spectrum
