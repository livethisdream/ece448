connections:
- [audio_filter, '0', deemphasis, '0']
- [carrier_recovery, '0', diff_decoder, '0']
- [carrier_recovery, '1', rds_null, '0']
- [carrier_recovery, '2', rds_null, '1']
- [carrier_recovery, '3', rds_null, '2']
- [carrier_recovery, '4', constellation, '0']
- [channel_filter, '0', fm_demod, '0']
- [deemphasis, '0', volume, '0']
- [diff_decoder, '0', rds_decoder, '0']
- [file_source, '0', channel_filter, '0']
- [file_source, '0', rf_spectrum, '0']
- [fm_demod, '0', audio_filter, '0']
- [fm_demod, '0', mpx_spectrum, '0']
- [fm_demod, '0', rds_shift, '0']
- [matched_filter, '0', rds_agc, '0']
- [pluto, '0', channel_filter, '0']
- [pluto, '0', rf_spectrum, '0']
- [rds_agc, '0', symbol_sync, '0']
- [rds_decoder, out, rds_parser, in]
- [rds_parser, out, rds_panel, in]
- [rds_shift, '0', to_19k, '0']
- [symbol_sync, '0', carrier_recovery, '0']
- [to_19k, '0', matched_filter, '0']
- [volume, '0', audio_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
