    alias: ''
    bus_structure_sink: '[[0,],]'
    comment: ''
    num_inputs: '3'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 940]
    rotation: 0
    state: enabled
- name: rds_panel
  id: rds_panel
  parameters:
    affinity: ''
