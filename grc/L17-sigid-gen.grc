connections:
- [add_a, '0', head_a, '0']
- [add_b, '0', head_b, '0']
- [add_c, '0', head_c, '0']
- [c2f_a, '0', nrz_a, '0']
- [fm_a, '0', mix_a, '0']
- [head_a, '0', sink_a, '0']
- [head_b, '0', sink_b, '0']
- [head_c, '0', sink_c, '0']
- [hops_c, '0', rep_c, '0']
- [lo_a, '0', mix_a, '1']
- [lo_b, '0', mix_b, '1']
- [map_b, '0', rep_b, '0']
- [mix_a, '0', add_a, '0']
- [mix_b, '0', add_b, '0']
- [noise_a, '0', add_a, '1']
- [noise_b, '0', add_b, '1']
- [noise_c, '0', add_c, '1']
- [nrz_a, '0', rep_a, '0']
- [rep_a, '0', fm_a, '0']
- [rep_b, '0', mix_b, '0']
- [rep_c, '0', vco_c, '0']
- [rnd_a, '0', c2f_a, '0']
- [rnd_b, '0', map_b, '0']
- [vco_c, '0', add_c, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
