  parameters:
    affinity: ''
    alias: ''
    author: ECE 448
    center_freq: 915e6
    comment: ''
    description: 'L17 SigID: unknown signal A, Simulated.'
    filename: L17-sigid-a
    hw_info: Simulated in GNU Radio; no radio
    sample_rate: samp_rate
    type: complex float (fc32_le)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
