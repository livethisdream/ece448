- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"Text Sink: shows each received packet as a line of text and\
      \ counts the\nlines that match the transmitted message. The counts restart whenever\
      \ a\nslider moves, because GRC sets `settings` each time noise or foff changes.\n\
      Function Probes read last_line() and stats() for the QT GUI Labels.\"\"\"\n\n\
      import time\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\n\
      class blk(gr.sync_block):\n    def __init__(self, expected='', settings=None):\n\
      \        gr.sync_block.__init__(self, name='Text Sink', in_sig=[np.uint8], out_sig=None)\n\
      \        self.expected = expected\n        self.key = pmt.intern('packet_len')\n\
      \        self.buf = ''\n        self.line = '(waiting for a packet)'\n     \
      \   self.settings = settings\n\n    @property\n    def settings(self):\n   \
      \     return self._settings\n\n    @settings.setter\n    def settings(self,\
      \ value):\n        self._settings = value\n        self.good = 0\n        self.total\
      \ = 0\n        self.t0 = time.monotonic()\n\n    def work(self, input_items,\
      \ output_items):\n        data = input_items[0]\n        start = self.nitems_read(0)\n\
      \        # Each packet starts with a packet_len tag, so a corrupted newline\n\
      \        # cannot run two packets together.\n        marks = {t.offset - start\
      \ for t in self.get_tags_in_window(0, 0, len(data), self.key)}\n        for\
      \ i, b in enumerate(data):\n            if i in marks and self.buf:\n      \
      \          self.finish()\n            self.buf += chr(b) if 32 <= b < 127 or\
      \ b == 10 else '?'\n        return len(data)\n\n    def finish(self):\n    \
      \    self.line = self.buf[:-1] if self.buf.endswith('\\n') else self.buf\n \
      \       self.total += 1\n        self.good += self.buf == self.expected + '\\\
      n'\n        self.buf = ''\n\n    def last_line(self):\n        return self.line\n\
      \n    def stats(self):\n        return f'{self.good} correct of {self.total}\
      \ received in {time.monotonic() - self.t0:.0f} s'\n"
    affinity: ''
    alias: ''
    comment: ''
    expected: msg
    maxoutbuf: '0'
    minoutbuf: '0'
    settings: (noise, foff)
  states:
    _io_cache: ('Text Sink', 'blk', [('expected', "''"), ('settings', 'None')], [('0',
      'byte', 1)], [], '', ['expected', 'settings'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1270, 590]
    rotation: 0
    state: enabled
