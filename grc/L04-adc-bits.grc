    state: enabled
- name: weak_db
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,2,1,1
    label: Weak signal (dBFS at 0 dB gain)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-100'
    step: '1'
    stop: '-20'
    value: '-70'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 12]
    rotation: 0
    state: enabled
- name: adc
  id: epy_block
  parameters:
    _source_code: "\"\"\"ADC: clips I and Q to full scale (-1 to +1) and rounds each\
      \ one to one of\n2**bits levels, the way an analog-to-digital converter does.\
      \ Values above full\nscale stay at the top level, which is clipping.\"\"\"\n\
      \nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, bits=8):\n        gr.sync_block.__init__(self, name='ADC',\
      \ in_sig=[np.complex64],\n                               out_sig=[np.complex64])\n\
      \        self.bits = bits\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        levels = 2.0 ** (int(self.bits) - 1)\n\n\
      \        def quantize(v):\n            v = np.clip(v, -1.0, 1.0 - 1.0 / levels)\n\
      \            return np.round(v * levels) / levels\n\n        output_items[0][:]\
      \ = quantize(x.real) + 1j * quantize(x.imag)\n        return len(x)\n"
    affinity: ''
    alias: ''
    bits: bits
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('ADC', 'blk', [('bits', '8')], [('0', 'complex', 1)], [('0', 'complex',
      1)], '', ['bits'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 312]
    rotation: 0
    state: enabled
