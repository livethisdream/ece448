    label0: 8 bits (RTL-SDR, HackRF)
    label1: 12 bits (PlutoSDR)
    label2: 16 bits
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '3'
    option0: '8'
    option1: '12'
    option2: '16'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: int
    value: '8'
    widget: combo_box
  states:
