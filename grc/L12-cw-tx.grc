    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L12 - CW Keyer
    window_size: (1060,600)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

