connections:
- [analog_const_source_x_0, '0', qtgui_time_sink_x_0, '2']
- [blocks_add_const_vxx_0, '0', qtgui_time_sink_x_0, '1']
- [blocks_multiply_const_vxx_0, '0', blocks_add_const_vxx_0, '0']
- [ece448_energy_detector_0, '0', qtgui_time_sink_x_0, '0']
- [ece448_energy_detector_0, '1', blocks_multiply_const_vxx_0, '0']
- [freq_xlating_fir_filter_xxx_0, '0', ece448_energy_detector_0, '0']
- [freq_xlating_fir_filter_xxx_0, '0', qtgui_freq_sink_x_0, '0']
- [freq_xlating_fir_filter_xxx_0, '0', waterfall, '0']
