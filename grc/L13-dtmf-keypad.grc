connections:
- [add, '0', gate, '0']
- [col_src, '0', add, '1']
- [gate, '0', fsink, '0']
- [gate, '0', resamp, '0']
- [gate, '0', tsink, '0']
- [resamp, '0', audio_out, '0']
- [row_src, '0', add, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
