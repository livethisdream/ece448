  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [580, 236]
    rotation: 0
    state: enabled
- name: row_src
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.3'
    comment: Row tone
    freq: row_f
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
