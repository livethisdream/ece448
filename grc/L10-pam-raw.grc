options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L10 Lab: the PAM link with no access code or header. The receiver
      groups the bits into bytes from wherever it starts; move the bit offset until
      the text reads.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L10_pam_raw
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L10 - Raw Bits, No Packets
    window_size: (1000,200)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: alpha
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [370, 12]
    rotation: 0
    state: enabled
- name: bit_offset
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,1
    label: Bit offset
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '0'
    step: '1'
    stop: '7'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 12]
    rotation: 0
    state: enabled
- name: msg
  id: variable
  parameters:
    comment: ''
    value: '''USAFA ECE 448: ASCII over PAM.'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [460, 12]
    rotation: 0
    state: enabled
- name: rx_label
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: '':  '' + x'
    gui_hint: 1,0,1,1
    label: Received bytes
    type: string
    value: rx_text
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1220, 12]
    rotation: 0
    state: enabled
- name: rx_start
  id: variable
  parameters:
    comment: ''
    value: random.randint(0, 999)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
