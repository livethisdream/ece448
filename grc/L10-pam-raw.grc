- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"Raw Text: shows the last 40 bytes from Repack Bits as text,\
      \ with no packets.\nA byte that does not print as an ASCII character shows as\
      \ a dot, and a newline\nas a bar. A Function Probe reads text() for the QT GUI\
      \ Label.\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, width=40):\n        gr.sync_block.__init__(self, name='Raw\
      \ Text', in_sig=[np.uint8], out_sig=None)\n        self.width = width\n    \
      \    self.buf = ''\n\n    def work(self, input_items, output_items):\n     \
      \   for b in input_items[0]:\n            self.buf += '|' if b == 10 else (chr(b)\
      \ if 32 <= b < 127 else '.')\n        self.buf = self.buf[-self.width:]\n  \
      \      return len(input_items[0])\n\n    def text(self):\n        return self.buf\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    width: '40'
  states:
    _io_cache: ('Raw Text', 'blk', [('width', '40')], [('0', 'byte', 1)], [], '',
      ['width'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 440]
    rotation: 0
    state: enabled
- name: fir_filter_xxx_0
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: Matched filter
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: rx_taps
    type: fff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 440]
    rotation: 0
    state: enabled
- name: import_0
  id: import
