- name: rx_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(1.0, samp_rate, samp_rate/sps, alpha, 11*sps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [420, 92]
    rotation: 0
    state: enabled
- name: rx_text
  id: variable_function_probe
  parameters:
    block_id: epy_block_0
    comment: ''
    function_args: ''
    function_name: text
    poll_rate: '4'
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1390, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
