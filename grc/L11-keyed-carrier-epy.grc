- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"Energy Detector, pasted into an Embedded Python Block. The\
      \ class is the\nsame as ece448.energy_detector in the L11 module; only its name\
      \ is blk.\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.decim_block):\n\
      \    \"\"\"\n    Energy Detector: averages |x|^2 over each run of `decim` input\
      \ samples\n    and makes one output sample per run on each of two outputs.\n\
      \n    Output 0 is that average power in dB. Output 1 is a key: 1.0 while a\n\
      \    signal is present and 0.0 while it is not. The key turns on when the\n\
      \    power rises above threshold_db and turns off only when the power falls\n\
      \    below threshold_db - hysteresis_db, so noise near the threshold does\n\
      \    not make the key chatter.\n    \"\"\"\n    def __init__(self, decim=32,\
      \ threshold_db=-20.0, hysteresis_db=3.0):\n        gr.decim_block.__init__(self,\n\
      \            name=\"Energy Detector\",\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.float32, np.float32],\n            decim=decim)\n \
      \       self.decim = decim\n        self.threshold_db = threshold_db\n     \
      \   self.hysteresis_db = hysteresis_db\n        self.key = 0.0          # the\
      \ key state carries over between calls\n\n    def set_threshold_db(self, threshold_db):\n\
      \        self.threshold_db = threshold_db\n\n    def set_hysteresis_db(self,\
      \ hysteresis_db):\n        self.hysteresis_db = hysteresis_db\n\n    def work(self,\
      \ input_items, output_items):\n        n = len(output_items[0])\n        x =\
      \ input_items[0][:n * self.decim].reshape(n, self.decim)\n        power_db =\
      \ 10 * np.log10(np.mean(x.real**2 + x.imag**2, axis=1) + 1e-12)\n        for\
      \ i, p in enumerate(power_db):\n            if self.key == 0.0 and p > self.threshold_db:\n\
      \                self.key = 1.0\n            elif self.key == 1.0 and p < self.threshold_db\
      \ - self.hysteresis_db:\n                self.key = 0.0\n            output_items[1][i]\
      \ = self.key\n        output_items[0][:] = power_db\n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    decim: decim
    hysteresis_db: hyst
    maxoutbuf: '0'
    minoutbuf: '0'
    threshold_db: threshold
  states:
    _io_cache: '(''Energy Detector'', ''blk'', [(''decim'', ''32''), (''threshold_db'',
      ''-20.0''), (''hysteresis_db'', ''3.0'')], [(''0'', ''complex'', 1)], [(''0'',
      ''float'', 1), (''1'', ''float'', 1)], ''\n    Energy Detector: averages |x|^2
      over each run of `decim` input samples\n    and makes one output sample per
      run on each of two outputs.\n\n    Output 0 is that average power in dB. Output
      1 is a key: 1.0 while a\n    signal is present and 0.0 while it is not. The
      key turns on when the\n    power rises above threshold_db and turns off only
      when the power falls\n    below threshold_db - hysteresis_db, so noise near
      the threshold does\n    not make the key chatter.\n    '', [''decim'', ''hysteresis_db'',
      ''threshold_db''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 390]
    rotation: 0
    state: enabled
