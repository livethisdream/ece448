options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L20: a line of text sent as OFDM packets with the blocks of the
      GNU Radio examples tx_ofdm.grc and rx_ofdm.grc: 64-point FFT, a 16-sample cyclic
      prefix, 48 data subcarriers and 4 pilots, a BPSK header, and a 16-QAM payload.
      The channel has the four multipath taps of L15-psk-multipath.grc, an echo whose
      delay and level are sliders, and noise. Watch the spectrum, the subcarrier points
      before and after the equalizer, and the received text. No hardware needed.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L20_ofdm_link
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L20 - Text over OFDM
    window_size: (1240,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: cp_len
  id: variable
  parameters:
    comment: ''
    value: fft_len//4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [380, 8]
    rotation: 0
    state: enabled
- name: echo_delay
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,2
    label: Echo delay (samples)
    min_len: '120'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '1'
    step: '1'
    stop: '40'
    value: '8'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [780, 170]
    rotation: 0
    state: enabled
