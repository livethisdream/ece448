options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L17: no hardware; transmits nothing. Opens a SigMF recording, shifts
      the carrier to 0 Hz, and takes the envelope with Complex to Mag; raise the Envelope
      gain until the pulses reach about 1, as a weak capture needs. The time sink
      triggers at the threshold, so you can measure the shortest pulse. Add Const
      subtracts the threshold, Binary Slicer turns the envelope into 0s and 1s, and
      the Chip Reader keeps the middle sample of each chip from each burst''s first
      rising edge, as a Keep 1 in N would, and prints one line of chips per burst
      with the pause after it. Set rec, samp_rate, and fc from the .sigmf-meta file,
      then the carrier offset, the threshold, and chip_len in samples.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L17_chips
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L17 - Read the Chips
    window_size: (1060,640)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    state: enabled

