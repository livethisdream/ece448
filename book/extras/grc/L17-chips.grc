- name: reader
  id: epy_block
  parameters:
    _source_code: "\"\"\"Chip Reader: reads the sliced envelope, one 0 or 1 per sample,\
      \ as one line of\nchips per burst. A burst's first rising edge starts the chip\
      \ clock, and the\nreader keeps the sample in the middle of each chip, as a Keep\
      \ 1 in N would.\nAfter 8 off chips the burst has ended: the line is printed,\
      \ with the pause\nbefore the next burst in samples, and shown in the window.\"\
      \"\"\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, chip_len=80):\n        gr.sync_block.__init__(self,\
      \ name='Chip Reader', in_sig=[np.uint8], out_sig=None)\n        self.chip_len\
      \ = max(1, int(chip_len))\n        self.runs = []       # (value, length) of\
      \ the burst in progress\n        self.active = False\n        self.off = 0 \
      \        # off samples since the last on sample\n        self.line = None  \
      \   # the last burst's chips, waiting for its pause\n        self.shown = '(waiting\
      \ for a burst)'\n\n    def set_chip_len(self, chip_len):\n        self.chip_len\
      \ = max(1, int(chip_len))\n\n    def last_line(self):\n        return self.shown\n\
      \n    def work(self, input_items, output_items):\n        x = (input_items[0]\
      \ > 0).astype(np.uint8)\n        edges = np.flatnonzero(np.diff(x)) + 1\n  \
      \      for seg in np.split(x, edges):\n            if len(seg) == 0:\n     \
      \           continue\n            v, n = int(seg[0]), len(seg)\n           \
      \ if v:\n                if not self.active:\n                    if self.line\
      \ is not None:\n                        self.shown = '%d chips: %s  pause %d\
      \ samples' % (len(self.line), self.line, self.off)\n                       \
      \ print(self.shown, flush=True)\n                    self.active, self.runs\
      \ = True, []\n                self.runs.append((1, n))\n                self.off\
      \ = 0\n            else:\n                self.off += n\n                if\
      \ self.active:\n                    self.runs.append((0, n))\n             \
      \       if self.off > 8 * self.chip_len:\n                        env = np.repeat([r[0]\
      \ for r in self.runs], [r[1] for r in self.runs])\n                        chips\
      \ = ''.join(str(c) for c in env[self.chip_len // 2::self.chip_len])\n      \
      \                  self.line = chips.rstrip('0')\n                        self.active\
      \ = False\n        return len(input_items[0])\n"
    affinity: ''
    alias: ''
    chip_len: chip_len
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Chip Reader', 'blk', [('chip_len', '80')], [('0', 'byte', 1)], [],
      '', ['chip_len'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1290, 300]
    rotation: 0
    state: enabled
