connections:
- [combine, '0', head, '0']
- [head, '0', to_iq, '0']
- [host_audio, '0', host_audio_lpf, '0']
- [host_audio_lpf, '0', host_upsample, '0']
- [host_fm, '0', combine, '0']
- [host_mpx, '0', host_fm, '0']
- [host_upsample, '0', host_mpx, '0']
- [interleave, '0', scale, '0']
- [lower_alloc, '0', lower_ifft, '0']
- [lower_bits, '0', lower_qpsk, '0']
- [lower_cp, '0', lower_level, '0']
- [lower_frame, '0', lower_alloc, '0']
- [lower_ifft, '0', lower_cp, '0']
- [lower_level, '0', combine, '3']
- [lower_qpsk, '0', lower_frame, '0']
- [neighbor_audio, '0', neighbor_audio_lpf, '0']
