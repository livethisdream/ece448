- [noise, '0', combine, '4']
- [offset, '0', to_uchar, '0']
- [pilot, '0', host_mpx, '1']
- [scale, '0', offset, '0']
- [to_iq, '0', interleave, '0']
- [to_iq, '1', interleave, '1']
- [to_uchar, '0', file_sink, '0']
- [upper_alloc, '0', upper_ifft, '0']
- [upper_bits, '0', upper_qpsk, '0']
- [upper_cp, '0', upper_level, '0']
- [upper_frame, '0', upper_alloc, '0']
- [upper_ifft, '0', upper_cp, '0']
- [upper_level, '0', combine, '2']
- [upper_qpsk, '0', upper_frame, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
