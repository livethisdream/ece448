options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L14: writes L14-hd-test.cu8, 4 s of a simulated hybrid HD Radio
      station: an FM host, two OFDM sidebands at levels set by upper_dbc and lower_dbc,
      an analog-only neighbor, and noise, as unsigned 8-bit IQ at 1,488,375 samples
      per second, the default input format of nrsc5. Simulated: the sidebands carry
      random QPSK, not NRSC-5 data. Nothing transmits.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: L14_hd_test_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L14 - HD Radio Test File
    window_size: (1000,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: audio_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate / 25
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 8]
    rotation: 0
    state: enabled
- name: cp_len
  id: variable
  parameters:
    comment: ''
    value: '224'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 8]
    rotation: 0
    state: enabled
- name: deviation
  id: variable
  parameters:
    comment: ''
    value: 75e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [976, 8]
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    comment: ''
    value: '4096'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 8]
    rotation: 0
    state: enabled
- name: inner
  id: variable
  parameters:
    comment: ''
    value: '356'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 8]
    rotation: 0
    state: enabled
- name: lower_carriers
  id: variable
  parameters:
    comment: ''
    value: list(range(-546, -inner + 1))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 80]
    rotation: 0
    state: enabled
- name: lower_dbc
  id: variable
  parameters:
    comment: ''
    value: '-23'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [744, 8]
    rotation: 0
    state: enabled
- name: lower_gain
  id: variable
  parameters:
    comment: ''
    value: (10**(lower_dbc/10) / len(lower_carriers))**0.5
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 80]
    rotation: 0
    state: enabled
- name: neighbor_khz
  id: variable
  parameters:
    comment: ''
    value: '-400'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [976, 80]
    rotation: 0
    state: enabled
- name: noise_amp
  id: variable
  parameters:
    comment: ''
    value: '0.03'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 8]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '1488375'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: seconds
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 80]
    rotation: 0
    state: enabled
- name: upper_carriers
  id: variable
  parameters:
    comment: ''
    value: list(range(inner, 547))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 80]
    rotation: 0
    state: enabled
- name: upper_dbc
  id: variable
  parameters:
    comment: ''
    value: '-23'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 8]
    rotation: 0
    state: enabled
- name: upper_gain
  id: variable
  parameters:
    comment: ''
    value: (10**(upper_dbc/10) / len(upper_carriers))**0.5
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 80]
    rotation: 0
    state: enabled
- name: combine
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '5'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1450, 320]
    rotation: 0
    state: enabled
- name: file_sink
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: '''L14-hd-test.cu8'''
    type: byte
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1580, 700]
    rotation: 0
    state: enabled
- name: head
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: int(seconds * samp_rate)
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1580, 230]
    rotation: 0
    state: enabled
- name: host_audio
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '16'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 500]
    rotation: 0
    state: enabled
- name: host_audio_lpf
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: 15e3
    decim: '1'
    gain: '0.33'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: audio_rate
    type: fir_filter_fff
    width: 2e3
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 480]
    rotation: 0
    state: enabled
- name: host_fm
  id: analog_frequency_modulator_fc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    sensitivity: 2 * math.pi * deviation / samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 500]
    rotation: 0
    state: enabled
- name: host_mpx
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 500]
    rotation: 0
    state: enabled
- name: host_upsample
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    decim: '1'
    fbw: '0'
    interp: '25'
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: '[]'
    type: fff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 488]
    rotation: 0
    state: enabled
- name: import_math
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 80]
    rotation: 0
    state: enabled
- name: interleave
  id: blocks_interleave
  parameters:
    affinity: ''
    alias: ''
    blocksize: '1'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1580, 400]
    rotation: 0
    state: enabled
- name: lower_alloc
  id: digital_ofdm_carrier_allocator_cvc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    fft_len: fft_len
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    occupied_carriers: (lower_carriers,)
    output_is_shifted: 'True'
    pilot_carriers: ((),)
    pilot_symbols: ((),)
    sync_words: ()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [670, 320]
    rotation: 0
    state: enabled
- name: lower_bits
