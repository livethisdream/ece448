    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: complex
    symbol_table: '[(1+1j)/2**0.5, (-1+1j)/2**0.5, (-1-1j)/2**0.5, (1-1j)/2**0.5]'
