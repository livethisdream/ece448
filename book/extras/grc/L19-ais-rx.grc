options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L19: receive AIS channels A and B from L19-ais-sim.sigmf-data (96
      kS/s, centered on 162 MHz): shift each channel to 0 Hz, squelch the noise between
      bursts, FM-demodulate it, recover the bit timing, slice the bits, and decode
      them with the AIS Decoder, an Embedded Python Block. Receive only.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L19_ais_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L19 - AIS Receiver
    window_size: (1060, 860)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: chan_a
  id: variable
  parameters:
    comment: ''
    value: -25e3
  states:
