- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"AIS Decoder: turns the sliced bits of channels A and B into\
      \ AIS messages.\n\nFor each channel, one bit at a time:\n1. Undo NRZI: a bit\
      \ that keeps the level is a 1, a change is a 0.\n2. Find the start flag, 01111110,\
      \ and collect bits up to the end flag.\n3. Remove the stuffed bits: drop the\
      \ 0 that follows five 1s.\n4. Check the 16-bit CRC. A frame that fails is counted\
      \ and dropped.\n5. Put each byte's bits back in order, print the message as\
      \ an NMEA\n   !AIVDM sentence, and decode the fields a chart plotter would show.\n\
      \nFunction Probes read stats() and table() for the QT GUI Labels.\"\"\"\n\n\
      import numpy as np\nfrom gnuradio import gr\n\nSIX = '@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\
      \\]^_ !\"#$%&\\'()*+,-./0123456789:;<=>?'\nFLAG = 0x7E\n\n\ndef val(b, signed=False):\n\
      \    v = 0\n    for x in b:\n        v = (v << 1) | x\n    return v - (1 <<\
      \ len(b)) if signed and b[0] else v\n\n\ndef crc_ok(b):\n    reg = 0xFFFF\n\
      \    for x in b:\n        reg = (reg >> 1) ^ 0x8408 if (reg ^ x) & 1 else reg\
      \ >> 1\n    return reg == 0xF0B8\n\n\ndef nmea(p, chan):\n    p = p + [0] *\
      \ (-len(p) % 6)\n    s = ''.join(chr(v + 48 if v < 40 else v + 56)\n       \
      \         for v in (val(p[i:i + 6]) for i in range(0, len(p), 6)))\n    parts\
      \ = [s[i:i + 60] for i in range(0, len(s), 60)]\n    out = []\n    for k, part\
      \ in enumerate(parts):\n        fill = -len(p) % 6 if k == len(parts) - 1 else\
      \ 0\n        body = f'AIVDM,{len(parts)},{k + 1},{\"1\" if len(parts) > 1 else\
      \ \"\"},{chan},{part},{fill}'\n        cs = 0\n        for c in body:\n    \
      \        cs ^= ord(c)\n        out.append(f'!{body}*{cs:02X}')\n    return out\n\
      \n\nclass Channel:\n    def __init__(self):\n        self.prev = 0\n       \
      \ self.shift = 0\n        self.frame = None\n        self.trained = False\n\n\
      \    def bit(self, level):\n        \"\"\"Feed one sliced bit. At a flag, returns\
      \ (bits since the last flag,\n        whether the training bits came before\
      \ it); otherwise None.\"\"\"\n        b = 1 if level == self.prev else 0\n \
      \       self.prev = level\n        self.shift = ((self.shift << 1) | b) & 0xFFFF\n\
      \        if self.frame is not None:\n            self.frame.append(b)\n    \
      \        if len(self.frame) > 1100:\n                self.frame = None\n   \
      \     if self.shift & 0xFF != FLAG:\n            return None\n        done =\
      \ None\n        if self.frame is not None and len(self.frame) > 8:\n       \
      \     done = (self.frame[:-8], self.trained)\n        # A new frame may start\
      \ here. Training bits, 0101..., before the\n        # flag mark a real start\
      \ rather than noise that happens to match.\n        self.trained = (self.shift\
      \ >> 8) in (0x55, 0xAA)\n        self.frame = []\n        return done\n\n\n\
      class blk(gr.sync_block):\n    def __init__(self, settings=None):\n        gr.sync_block.__init__(self,\
      \ name='AIS Decoder', in_sig=[np.uint8, np.uint8], out_sig=None)\n        self.ch\
      \ = {'A': Channel(), 'B': Channel()}\n        self.settings = settings\n\n \
      \   @property\n    def settings(self):\n        return self._settings\n\n  \
      \  @settings.setter\n    def settings(self, value):\n        # GRC sets this\
      \ when a slider it names moves: the counts and the\n        # table start over.\n\
      \        self._settings = value\n        self.ships = {}\n        self.good\
      \ = 0\n        self.bad = 0\n\n    def work(self, input_items, output_items):\n\
      \        for name, x in zip('AB', input_items):\n            c = self.ch[name]\n\
      \            for level in x:\n                got = c.bit(int(level))\n    \
      \            if got is not None and self.frame(*got, name):\n              \
      \      c.frame = None    # one frame per burst\n        return len(input_items[0])\n\
      \n    def frame(self, raw, trained, chan):\n        \"\"\"Unstuff and check\
      \ one frame. True if it passed the CRC.\"\"\"\n        b, run = [], 0\n    \
      \    for x in raw:\n            if run == 5:          # the 0 after five 1s\
      \ was stuffed\n                run = 0\n                continue\n         \
      \   b.append(x)\n            run = run + 1 if x else 0\n        if len(b) <\
      \ 72 or (len(b) - 16) % 8 or not crc_ok(b):\n            self.bad += trained\
      \ and len(b) >= 72\n            return False\n        self.good += 1\n     \
      \   p = []\n        for i in range(0, len(b) - 16, 8):\n            p += b[i:i\
      \ + 8][::-1]\n        self.report(p, chan)\n        return True\n\n    def report(self,\
      \ p, chan):\n        mtype, mmsi = val(p[0:6]), val(p[8:38])\n        s = self.ships.setdefault(mmsi,\
      \ {})\n        what = f'message {mtype}'\n        if mtype in (1, 2, 3) and\
      \ len(p) >= 168:\n            s['sog'] = val(p[50:60]) / 10\n            s['lon']\
      \ = val(p[61:89], True) / 600000\n            s['lat'] = val(p[89:116], True)\
      \ / 600000\n            s['cog'] = val(p[116:128]) / 10\n            what =\
      \ f'position {s[\"lat\"]:.4f}, {s[\"lon\"]:.4f}, {s[\"sog\"]} kt, course {s[\"\
      cog\"]}'\n        elif mtype == 18 and len(p) >= 168:\n            s['sog']\
      \ = val(p[46:56]) / 10\n            s['lon'] = val(p[57:85], True) / 600000\n\
      \            s['lat'] = val(p[85:112], True) / 600000\n            s['cog']\
      \ = val(p[112:124]) / 10\n            what = f'class B position {s[\"lat\"]:.4f},\
      \ {s[\"lon\"]:.4f}, {s[\"sog\"]} kt'\n        elif mtype == 5 and len(p) >=\
      \ 420:\n            txt = lambda a, n: ''.join(SIX[val(p[a + 6 * i:a + 6 * i\
      \ + 6])] for i in range(n)).strip('@ ')\n            s['name'], s['dest'] =\
      \ txt(112, 20), txt(302, 20)\n            s['type'] = val(p[232:240])\n    \
      \        s['len'] = val(p[240:249]) + val(p[249:258])\n            what = f'name\
      \ {s[\"name\"]}, callsign {txt(70, 7)}, type {s[\"type\"]}, {s[\"len\"]} m,\
      \ to {s[\"dest\"]}'\n        elif mtype == 24 and len(p) >= 160 and val(p[38:40])\
      \ == 0:\n            s['name'] = ''.join(SIX[val(p[40 + 6 * i:46 + 6 * i])]\
      \ for i in range(20)).strip('@ ')\n            what = f'name {s[\"name\"]}'\n\
      \        for line in nmea(p, chan):\n            print(line, flush=True)\n \
      \       print(f'    channel {chan}  MMSI {mmsi}  {what}', flush=True)\n\n  \
      \  def stats(self):\n        return f'{self.good} passed CRC, {self.bad} failed'\n\
      \n    def table(self):\n        rows = []\n        for mmsi, s in sorted(self.ships.items()):\n\
      \            pos = f'{s[\"lat\"]:.4f}, {s[\"lon\"]:.4f}' if 'lat' in s else\
      \ 'position ?'\n            rows.append(f'{mmsi}  {s.get(\"name\", \"?\")}:\
      \  {pos},  {s.get(\"sog\", \"?\")} kt,  '\n                        f'course\
      \ {s.get(\"cog\", \"?\")}')\n        return '\\n'.join(rows) or '(no ships yet)'\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    settings: (noise,)
  states:
    _io_cache: ('AIS Decoder', 'blk', [('settings', 'None')], [('0', 'byte', 1), ('1',
      'byte', 1)], [], '', ['settings'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1432, 360]
    rotation: 0
    state: enabled
