- name: rtl_sdr
  id: soapy_rtlsdr_source
  parameters:
    affinity: ''
    agc: 'False'
    alias: ''
    bias: 'False'
    bufflen: '16384'
    center_freq: fc_mhz * 1e6
    comment: ''
    dev_args: ''''''
    freq_correction: '0'
    gain: rf_gain
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fc32
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 390]
    rotation: 0
    state: disabled
- name: volume
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: vol
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1220, 300]
    rotation: 0
    state: enabled

connections:
- [agc, '0', audio_scope, '0']
- [agc, '0', volume, '0']
- [channel_filter, '0', channel_spectrum, '0']
- [channel_filter, '0', envelope, '0']
- [dc_block, '0', agc, '0']
- [envelope, '0', envelope_lpf, '0']
- [envelope_lpf, '0', dc_block, '0']
- [file_source, '0', channel_filter, '0']
- [file_source, '0', rf_spectrum, '0']
- [rtl_sdr, '0', channel_filter, '0']
- [rtl_sdr, '0', rf_spectrum, '0']
- [volume, '0', audio_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
