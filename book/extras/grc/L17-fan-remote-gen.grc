options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L17: makes the Simulated fan-remote recording L17-fan-remote.sigmf-data
      and .sigmf-meta: OOK, 3-chip PWM, five buttons pressed once each. No hardware;
      transmits nothing.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: L17_fan_remote_gen
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L17 - Simulated Fan Remote Generator
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    state: enabled

blocks:
- name: addr
  id: variable
  parameters:
    comment: ''
    value: '0xA6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 12]
    state: enabled
- name: chip_len
  id: variable
  parameters:
    comment: ''
    value: '80'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [300, 12]
    state: enabled
- name: chips
  id: variable
  parameters:
    comment: ''
    value: '[0]*625 + sum((frame(c)*6 + [0]*625 for c in cmds), [])'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 12]
    state: enabled
- name: cmds
  id: variable
  parameters:
    comment: ''
    value: '[0x1, 0x2, 0x3, 0x4, 0x5]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 12]
    state: enabled
- name: frame
  id: variable
  parameters:
    comment: ''
    value: 'lambda c: sum((pat[((addr << 8 | c << 4 | (c ^ 0xF)) >> (15 - i)) & 1]
      for i in range(16)), []) + [0]*30'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 12]
    state: enabled
- name: pat
  id: variable
  parameters:
    comment: ''
    value: '{0: [1, 0, 0], 1: [1, 1, 0]}'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 12]
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    state: enabled
- name: add
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '3'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 260]
    state: enabled
- name: carrier
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1'
    comment: ''
    freq: '40000'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 300]
    state: enabled
- name: f2c
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 200]
    state: enabled
- name: head
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: len(chips)*chip_len
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 260]
    state: enabled
- name: mult
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 220]
    state: enabled
- name: noise
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.05'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '17'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 440]
    state: enabled
- name: other
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.03'
    comment: ''
    freq: '-62000'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 340]
    state: enabled
- name: rep
  id: blocks_repeat
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    interp: chip_len
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 200]
    state: enabled
- name: sink
  id: blocks_sigmf_sink_minimal
  parameters:
    affinity: ''
    alias: ''
    author: ECE 448
    center_freq: 350e6
    comment: ''
    description: 'Simulated fan remote, OOK. Buttons pressed once each, in order:
      Light, Fan Off, Low, Medium, High.'
    filename: L17-fan-remote
    hw_info: Simulated in GNU Radio; no radio
    sample_rate: samp_rate
    type: complex float (fc32_le)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1060, 260]
    state: enabled
- name: vsrc
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: float
    vector: chips
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 200]
    state: enabled

connections:
- [add, '0', head, '0']
- [carrier, '0', mult, '1']
- [f2c, '0', mult, '0']
- [head, '0', sink, '0']
- [mult, '0', add, '0']
- [noise, '0', add, '2']
- [other, '0', add, '1']
- [rep, '0', f2c, '0']
- [vsrc, '0', rep, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
