options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L18: a simulated sky of four aircraft sending ADS-B extended squitters,
      built from pulse-position modulation (PPM) at 2 MS/s. Writes 0.5 s to L18-adsb-sim.sigmf-data
      and .sigmf-meta, labeled Simulated, then stops. Nothing transmits: the last
      block is a SigMF file sink.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L18_adsb_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L18 - ADS-B Out Generator
    window_size: (1060, 520)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
