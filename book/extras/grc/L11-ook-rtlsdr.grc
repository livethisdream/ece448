    bus_structure: null
    coordinate: [900, 200]
    rotation: 0
    state: enabled
- name: soapy_rtlsdr_source_0
  id: soapy_rtlsdr_source
  parameters:
    affinity: ''
    agc: 'False'
    alias: ''
    bias: 'False'
    bufflen: '16384'
    center_freq: 433.92e6 - offset
    comment: ''
    dev_args: ''''''
    freq_correction: '0'
    gain: rf_gain
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fc32
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 220]
    rotation: 0
    state: enabled

connections:
- [analog_const_source_x_0, '0', qtgui_time_sink_x_0, '2']
- [ece448_energy_detector_0, '0', qtgui_time_sink_x_0, '0']
- [ece448_energy_detector_0, '1', qtgui_time_sink_x_0, '1']
- [freq_xlating_fir_filter_xxx_0, '0', ece448_energy_detector_0, '0']
- [freq_xlating_fir_filter_xxx_0, '0', qtgui_freq_sink_x_0, '0']
- [soapy_rtlsdr_source_0, '0', freq_xlating_fir_filter_xxx_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
