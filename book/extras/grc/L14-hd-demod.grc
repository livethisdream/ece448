- name: subcarriers
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nNRSC-5 Subcarriers: takes one FFT per symbol and pulls\
      \ out the two kinds of\nsubcarrier in the primary sidebands.\n\nReference subcarriers\
      \ sit every 19th subcarrier, 356 to 546 on each side.\nThey carry differential\
      \ BPSK, so multiplying each one by its value one symbol\nearlier gives two points,\
      \ +1 and -1, whatever the channel did. A subcarrier\nthat keeps doing that is\
      \ a reference; the score output plots how strongly\neach of the fft_len subcarriers\
      \ does, and the block finds the references (and any whole-subcarrier\nfrequency\
      \ offset) from where the score peaks.\n\nBetween each pair of references are\
      \ 18 data subcarriers, QPSK. The two\nreferences measure what the channel did\
      \ to their neighborhood, and dividing\neach data subcarrier by that estimate\
      \ leaves four points.\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\
      \n\nclass blk(gr.basic_block):\n\n    def __init__(self, fft_len=2048, cp_len=112,\
      \ search=40):\n        self.N, self.search = int(fft_len), int(search)\n   \
      \     self.S = self.N + int(cp_len)\n        gr.basic_block.__init__(self, name='NRSC-5\
      \ Subcarriers',\n                                in_sig=[(np.complex64, self.N)],\n\
      \                                out_sig=[(np.float32, self.N),\n          \
      \                               np.complex64, np.complex64])\n        upper\
      \ = 356 + 19 * np.arange(11)\n        self.refs = np.concatenate([-upper[::-1],\
      \ upper])\n        # Each data subcarrier, the references on either side, and\
      \ how far\n        # it sits between them.\n        k, a, w = [], [], []\n \
      \       for side in (-1, 1):\n            r = np.sort(side * upper)\n      \
      \      for lo in r[:-1]:\n                for i in range(1, 19):\n         \
      \           k.append(lo + i); a.append(lo); w.append(i / 19)\n        self.k,\
      \ self.a, self.w = np.array(k), np.array(a), np.array(w)\n        self.score\
      \ = np.zeros(self.N, np.float32)\n        self.votes = np.zeros(2 * self.search\
      \ + 1)\n        self.prev = None\n        self.offset = 0\n        self.out\
      \ = ([], [], [])\n\n    def forecast(self, noutput_items, ninputs):\n      \
      \  return [1] * ninputs\n\n    def symbol(self, X):\n        c = self.N // 2\n\
      \        if self.prev is None:\n            self.prev = X\n            return\n\
      \        d = X * np.conj(self.prev)\n        # A symbol lasts fft_len + cp_len\
      \ samples, so an offset of a whole\n        # subcarrier still turns each subcarrier\
      \ a little from one symbol to\n        # the next. Try each offset with that\
      \ turn taken out.\n        shifts = np.arange(-self.search, self.search + 1)\n\
      \        turn = np.exp(-2j * np.pi * shifts * self.S / self.N)\n        dr =\
      \ d[c + self.refs[None, :] + shifts[:, None]] * turn[:, None]\n        votes\
      \ = ((np.abs(dr.real) - np.abs(dr.imag)) / (np.abs(dr) + 1e-12)).sum(axis=1)\n\
      \        self.votes = 0.9 * self.votes + 0.1 * votes\n        self.offset =\
      \ int(shifts[int(np.argmax(self.votes))])\n        d = d * np.exp(-2j * np.pi\
      \ * self.offset * self.S / self.N)\n        s = (np.abs(d.real) - np.abs(d.imag))\
      \ / (np.abs(d) + 1e-12)\n        self.score = 0.95 * self.score + 0.05 * s\n\
      \        off = c + self.offset\n        self.out[0].append(self.score.copy())\n\
      \        r = off + self.refs\n        ref = d[r] / (np.abs(X[r]) * np.abs(self.prev[r])\
      \ + 1e-12)\n        # What frequency error is left turns every reference the\
      \ same way;\n        # squaring removes the BPSK sign, so the average shows\
      \ that turn.\n        ref *= np.exp(-0.5j * np.angle(np.sum(ref ** 2)))\n  \
      \      self.out[1].extend(ref)\n        H2a = X[off + self.a] ** 2\n       \
      \ H2b = X[off + self.a + 19] ** 2\n        H = np.sqrt((1 - self.w) * H2a +\
      \ self.w * H2b)\n        self.out[2].extend(X[off + self.k] / (H + 1e-12) *\
      \ np.exp(1j * np.pi / 4))\n        self.prev = X\n\n    def general_work(self,\
      \ input_items, output_items):\n        # Decode only while the plots keep up,\
      \ so nothing piles up here.\n        used = 0\n        for X in input_items[0]:\n\
      \            if len(self.out[2]) > 4096:\n                break\n          \
      \  self.symbol(X)\n            used += 1\n        self.consume(0, used)\n  \
      \      for port in range(3):\n            q = self.out[port]\n            n\
      \ = min(len(q), len(output_items[port]))\n            for i in range(n):\n \
      \               output_items[port][i] = q[i]\n            del q[:n]\n      \
      \      self.produce(port, n)\n        return gr.WORK_CALLED_PRODUCE\n"
    affinity: ''
    alias: ''
    comment: ''
    cp_len: cp_len
    fft_len: fft_len
    maxoutbuf: '0'
    minoutbuf: '0'
    search: '40'
  states:
    _io_cache: ('NRSC-5 Subcarriers', 'blk', [('fft_len', '2048'), ('cp_len', '112'),
      ('search', '40')], [('0', 'complex', 2048)], [('0', 'float', 2048), ('1', 'complex',
      1), ('2', 'complex', 1)], '', ['search'])
