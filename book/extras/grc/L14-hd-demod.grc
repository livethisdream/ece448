- name: symbol_sync
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nNRSC-5 Symbol Sync: finds where each OFDM symbol starts\
      \ and removes the\nradio's fine frequency offset, both from the cyclic prefix,\
      \ then hands the\nFFT one symbol at a time.\n\nEvery symbol is fft_len samples\
      \ plus a cyclic prefix of cp_len: the symbol's\nlast cp_len samples, copied\
      \ to its front. Multiplying the signal by a copy of\nitself fft_len samples\
      \ later lights up exactly where the copies line up, once\nper symbol, and the\
      \ angle of that product is the frequency offset. Each\nsymbol is tapered at\
      \ both ends and its tail folded onto its head before the\nFFT, the way nrsc5\
      \ does it.\n\nFeed it the sidebands only: the analog FM host is far stronger\
      \ and has no\ncyclic prefix.\n\"\"\"\nimport numpy as np\nfrom gnuradio import\
      \ gr\n\n\nclass blk(gr.basic_block):\n\n    def __init__(self, fft_len=2048,\
      \ cp_len=112, samp_rate=744187.5, symbols=16):\n        self.N, self.CP = int(fft_len),\
      \ int(cp_len)\n        gr.basic_block.__init__(self, name='NRSC-5 Symbol Sync',\n\
      \                                in_sig=[np.complex64],\n                  \
      \              out_sig=[(np.complex64, self.N)])\n        self.fs, self.K =\
      \ float(samp_rate), int(symbols)\n        self.S = self.N + self.CP\n      \
      \  j = np.arange(self.S)\n        self.shape = np.where(\n            j < self.CP,\
      \ np.sin(np.pi / 2 * j / self.CP),\n            np.where(j < self.N, 1.0,\n\
      \                     np.cos(np.pi / 2 * (j - self.N) / self.CP))).astype(np.float32)\n\
      \        self.buf = np.zeros(0, np.complex64)\n        self.ready = []     \
      \    # symbols waiting for room at the output\n        self.phase = 0.0    \
      \    # running phase of the frequency correction\n        self.freq = 0.0  \
      \       # latest frequency offset estimate, Hz\n        self.start_index = 0\
      \    # latest symbol start, in samples\n\n    def forecast(self, noutput_items,\
      \ ninputs):\n        return [1] * ninputs\n\n    def chunk(self):\n        \"\
      \"\"Estimate timing and frequency over K symbols, then cut them out.\"\"\"\n\
      \        N, CP, S, K = self.N, self.CP, self.S, self.K\n        seg = self.buf[:K\
      \ * S + S]\n        p = seg[:-N] * np.conj(seg[N:])\n        c = np.concatenate([[0],\
      \ np.cumsum(p)])\n        m = c[CP:CP + K * S] - c[:K * S]           # sum over\
      \ each cp_len window\n        M = m.reshape(K, S).sum(axis=0)             #\
      \ stack K symbols\n        idx = int(np.argmax(np.abs(M)))\n        self.start_index\
      \ = idx\n        self.freq = -np.angle(M[idx]) * self.fs / (2 * np.pi * N)\n\
      \        w = -2 * np.pi * self.freq / self.fs\n        n = np.arange(S)\n  \
      \      for i in range(K):\n            start = idx + i * S\n            v =\
      \ seg[start:start + S] * np.exp(1j * (self.phase + w * (start + n))) * self.shape\n\
      \            body = v[:N].copy()\n            body[:CP] += v[N:]\n         \
      \   self.ready.append(body.astype(np.complex64))\n        self.phase = (self.phase\
      \ + w * K * S) % (2 * np.pi)\n        self.buf = self.buf[K * S:]\n\n    def\
      \ general_work(self, input_items, output_items):\n        need = self.K * self.S\
      \ + self.S\n        x = input_items[0]\n        take = min(len(x), max(0, 2\
      \ * need - len(self.buf)))\n        if take:\n            self.buf = np.concatenate([self.buf,\
      \ x[:take]])\n            self.consume(0, take)\n        while len(self.buf)\
      \ >= need and len(self.ready) < 2 * self.K:\n            self.chunk()\n    \
      \    out = output_items[0]\n        n = min(len(self.ready), len(out))\n   \
      \     for i in range(n):\n            out[i] = self.ready[i]\n        del self.ready[:n]\n\
      \        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    cp_len: cp_len
    fft_len: fft_len
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    symbols: '16'
  states:
    _io_cache: ('NRSC-5 Symbol Sync', 'blk', [('fft_len', '2048'), ('cp_len', '112'),
      ('samp_rate', '744187.5'), ('symbols', '16')], [('0', 'complex', 1)], [('0',
      'complex', 2048)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 380]
    rotation: 0
    state: enabled
