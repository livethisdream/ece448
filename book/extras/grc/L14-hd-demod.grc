options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L14: the steps from HD Radio sidebands to QPSK points, on a recording
      of a real station: complex float at 744,187.5 samples per second, such as the
      hd.sigmf-data that L14-hd-find.grc records. A band-pass filter keeps the two
      sidebands. The cyclic prefix, stacked over 16 symbols, marks where each OFDM
      symbol starts. An FFT turns each symbol into subcarriers, the reference subcarriers
      stand out as steady differential BPSK, and they equalize the data subcarriers
      into QPSK. To go live, disable the File Source and Throttle and enable the PlutoSDR
      Source and Rational Resampler. Receive only.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L14_hd_demod
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L14 - Demodulating the HD Radio Sidebands
    window_size: (1400,820)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

