- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"Mode S Decoder: finds ADS-B messages in the magnitude of\
      \ a 2 MS/s stream.\n\n1. Find a preamble: pulses at chips 0, 2, 7, and 9, quiet\
      \ between them.\n2. Read 112 bits: each bit is a pair of chips, and the larger\
      \ one says\n   which half held the pulse (pulse first is a 1).\n3. Check the\
      \ 24 parity bits. A message that fails is counted and dropped.\n4. Print the\
      \ message in hex and what it says, and update the aircraft table.\n\nPositions\
      \ use the one-frame (local) decode, which is correct within about\n180 nautical\
      \ miles of the reference position, here USAFA. Function Probes\nread stats()\
      \ and table() for the QT GUI Labels.\"\"\"\n\nimport math\n\nimport numpy as\
      \ np\nfrom gnuradio import gr\n\nCHARS = '#ABCDEFGHIJKLMNOPQRSTUVWXYZ##### ###############0123456789######'\n\
      HIGH = [0, 2, 7, 9]\nQUIET = [1, 3, 4, 5, 6, 8, 10, 11, 12, 13, 14, 15]\nN =\
      \ 16 + 224\n\n\ndef val(b):\n    v = 0\n    for x in b:\n        v = (v << 1)\
      \ | int(x)\n    return v\n\n\ndef remainder(b):\n    \"\"\"Zero for a message\
      \ whose parity bits are right (generator 0x1FFF409).\"\"\"\n    reg = 0\n  \
      \  for x in b:\n        reg = (reg << 1) | int(x)\n        if reg & 0x1000000:\n\
      \            reg ^= 0x1FFF409\n    return reg\n\n\ndef nl(lat):\n    if abs(lat)\
      \ >= 87:\n        return 1\n    a = 1 - math.cos(math.pi / 30)\n    return int(2\
      \ * math.pi / math.acos(1 - a / math.cos(math.radians(lat)) ** 2))\n\n\nclass\
      \ blk(gr.sync_block):\n    def __init__(self, samp_rate=2e6, ref_lat=38.99,\
      \ ref_lon=-104.86, settings=None):\n        gr.sync_block.__init__(self, name='Mode\
      \ S Decoder', in_sig=[np.float32], out_sig=None)\n        self.set_history(N)\n\
      \        self.fs = samp_rate\n        self.ref = (ref_lat, ref_lon)\n      \
      \  self.settings = settings\n\n    @property\n    def settings(self):\n    \
      \    return self._settings\n\n    @settings.setter\n    def settings(self, value):\n\
      \        # GRC sets this when a slider it names moves: the counts and the\n\
      \        # table start over.\n        self._settings = value\n        self.planes\
      \ = {}\n        self.good = 0\n        self.bad = 0\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        n = len(x) - N + 1\n \
      \       if n <= 0:\n            return 0\n        floor = np.median(x) + 1e-6\n\
      \        hi = np.min([x[k:k + n] for k in HIGH], axis=0)\n        lo = np.mean([x[k:k\
      \ + n] for k in QUIET], axis=0)\n        cand = np.flatnonzero((hi > 3 * floor)\
      \ & (hi > 2.5 * lo))\n        skip = -1\n        for i in cand:\n          \
      \  if i < skip:\n                continue\n            c = x[i + 16:i + N]\n\
      \            b = c[0::2] > c[1::2]\n            df = val(b[:5])\n          \
      \  if df not in (17, 18):\n                continue\n            if remainder(b):\n\
      \                self.bad += 1\n                continue\n            self.good\
      \ += 1\n            skip = i + N\n            self.report(b, (self.nitems_read(0)\
      \ + i) / self.fs)\n        return n\n\n    def report(self, b, t):\n       \
      \ icao = f'{val(b[8:32]):06X}'\n        me = b[32:88]\n        tc = val(me[:5])\n\
      \        p = self.planes.setdefault(icao, {})\n        what = f'type code {tc}'\n\
      \        if 1 <= tc <= 4:\n            p['call'] = ''.join(CHARS[val(me[8 +\
      \ 6 * k:14 + 6 * k])] for k in range(8)).strip(' #')\n            what = f'callsign\
      \ {p[\"call\"]}'\n        elif 9 <= tc <= 18:\n            a = me[8:20]\n  \
      \          p['alt'] = val(np.r_[a[:7], a[8:]]) * 25 - 1000 if a[7] else None\n\
      \            odd = int(me[21])\n            yz, xz = val(me[22:39]) / 2 ** 17,\
      \ val(me[39:56]) / 2 ** 17\n            dlat = 360 / (59 if odd else 60)\n \
      \           lat = dlat * (math.floor(self.ref[0] / dlat)\n                 \
      \         + math.floor(0.5 + (self.ref[0] % dlat) / dlat - yz) + yz)\n     \
      \       dlon = 360 / max(nl(lat) - odd, 1)\n            lon = dlon * (math.floor(self.ref[1]\
      \ / dlon)\n                          + math.floor(0.5 + (self.ref[1] % dlon)\
      \ / dlon - xz) + xz)\n            p['pos'] = (lat, lon)\n            what =\
      \ f'altitude {p[\"alt\"]} ft, position {lat:.4f}, {lon:.4f}'\n        elif tc\
      \ == 19 and val(me[5:8]) in (1, 2):\n            ve = (val(me[14:24]) - 1) *\
      \ (-1 if me[13] else 1)\n            vn = (val(me[25:35]) - 1) * (-1 if me[24]\
      \ else 1)\n            p['spd'] = round(math.hypot(ve, vn))\n            p['trk']\
      \ = round(math.degrees(math.atan2(ve, vn)) % 360)\n            p['vr'] = (val(me[37:46])\
      \ - 1) * 64 * (-1 if me[36] else 1)\n            what = f'{p[\"spd\"]} kt, track\
      \ {p[\"trk\"]} deg, {p[\"vr\"]:+d} ft/min'\n        p['t'] = t\n        print(f'{t:8.4f}\
      \ s  {val(b):028X}  ICAO {icao}  {what}', flush=True)\n\n    def stats(self):\n\
      \        return f'{self.good} passed parity, {self.bad} failed'\n\n    def table(self):\n\
      \        rows = []\n        for icao, p in sorted(self.planes.items()):\n  \
      \          pos = p.get('pos')\n            rows.append(f'{icao}  {p.get(\"call\"\
      , \"?\")}:  {p.get(\"alt\", \"?\")} ft,  '\n                        f'{p.get(\"\
      spd\", \"?\")} kt,  track {p.get(\"trk\", \"?\")},  '\n                    \
      \    + (f'{pos[0]:.3f}, {pos[1]:.3f}' if pos else 'position ?'))\n        return\
      \ '\\n'.join(rows) or '(no aircraft yet)'\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    ref_lat: '38.99'
    ref_lon: '-104.86'
    samp_rate: samp_rate
    settings: (noise,)
  states:
    _io_cache: ('Mode S Decoder', 'blk', [('samp_rate', '2000000.0'), ('ref_lat',
      '38.99'), ('ref_lon', '-104.86'), ('settings', 'None')], [('0', 'float', 1)],
      [], '', ['settings'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 392]
    rotation: 0
    state: enabled
