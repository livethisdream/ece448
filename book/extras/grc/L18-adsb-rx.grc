- name: table_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"Aircraft Table: shows what gr-adsb's ADS-B Decoder has decoded.\n\
      \nThis block decodes nothing. gr-adsb's Demod sends every burst it finds to\
      \ the\n\"found\" port, and its Decoder sends every message that passed parity,\
      \ with\neverything it knows about that aircraft so far, to the \"decoded\" port.\
      \ This\nblock counts both and keeps one row per aircraft. Function Probes read\n\
      stats() and table() for the QT GUI Labels; both start over when a slider in\n\
      `settings` moves.\"\"\"\n\nimport math\n\nimport numpy as np\nimport pmt\nfrom\
      \ gnuradio import gr\n\n\ndef num(v, fmt):\n    try:\n        v = float(v)\n\
      \    except (TypeError, ValueError):\n        return ''\n    return '' if math.isnan(v)\
      \ else fmt.format(v)\n\n\nclass blk(gr.basic_block):\n    def __init__(self,\
      \ settings=None):\n        gr.basic_block.__init__(self, name='Aircraft Table',\
      \ in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('found'))\n\
      \        self.message_port_register_in(pmt.intern('decoded'))\n        self.set_msg_handler(pmt.intern('found'),\
      \ self.on_found)\n        self.set_msg_handler(pmt.intern('decoded'), self.on_decoded)\n\
      \        self._settings = settings\n        self.reset()\n\n    def reset(self):\n\
      \        self.n_found = 0\n        self.n_decoded = 0\n        self.planes =\
      \ {}\n\n    @property\n    def settings(self):\n        return self._settings\n\
      \n    @settings.setter\n    def settings(self, value):\n        if value !=\
      \ self._settings:\n            self.reset()\n        self._settings = value\n\
      \n    def on_found(self, msg):\n        self.n_found += 1\n\n    def on_decoded(self,\
      \ msg):\n        self.n_decoded += 1\n        d = pmt.to_python(pmt.car(msg))\n\
      \        self.planes[d.get('icao', '?')] = d\n\n    def stats(self):\n     \
      \   return f'{self.n_found} bursts found, {self.n_decoded} decoded'\n\n    def\
      \ table(self):\n        rows = []\n        for icao, d in sorted(self.planes.items()):\n\
      \            cs = (d.get('callsign') or '').strip()\n            alt = num(d.get('altitude'),\
      \ '{:.0f} ft')\n            spd = num(d.get('speed'), '{:.0f} kt')\n       \
      \     # gr-adsb's heading is a math angle, 0 east and 90 north;\n          \
      \  # a track is a compass angle, 0 north and 90 east\n            hdg = d.get('heading')\n\
      \            trk = num(None if hdg is None else (90 - float(hdg)) % 360, 'track\
      \ {:.0f}')\n            lat, lon = num(d.get('latitude'), '{:.3f}'), num(d.get('longitude'),\
      \ '{:.3f}')\n            pos = f'{lat}, {lon}' if lat and lon else ''\n    \
      \        rows.append(f'{icao.upper()}  {cs}:  ' + ',  '.join(x for x in (alt,\
      \ spd, trk, pos) if x))\n        return '\\n'.join(rows)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    settings: (noise, threshold)
  states:
    _io_cache: ('Aircraft Table', 'blk', [('settings', 'None')], [('decoded', 'message',
      1), ('found', 'message', 1)], [], '', ['settings'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1232, 488]
    rotation: 0
    state: enabled

connections:
- [adsb_decoder_0, decoded, table_0, decoded]
- [adsb_demod_0, '0', blocks_null_sink_0, '0']
- [adsb_demod_0, demodulated, adsb_decoder_0, demodulated]
- [adsb_demod_0, demodulated, table_0, found]
- [adsb_framer_0, '0', adsb_demod_0, '0']
- [analog_noise_source_x_0, '0', blocks_add_xx_0, '1']
- [blocks_add_xx_0, '0', blocks_complex_to_mag_squared_0, '0']
- [blocks_complex_to_mag_squared_0, '0', adsb_framer_0, '0']
- [blocks_complex_to_mag_squared_0, '0', qtgui_time_sink_x_0, '0']
- [blocks_complex_to_mag_squared_0, '0', qtgui_time_sink_x_1, '0']
- [blocks_sigmf_source_minimal_0, '0', blocks_throttle2_0, '0']
- [blocks_throttle2_0, '0', blocks_add_xx_0, '0']
- [iio_pluto_source_0, '0', blocks_add_xx_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
