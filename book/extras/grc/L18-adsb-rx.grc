options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L18: receive ADS-B at 1090 MHz from L18-adsb-sim.sigmf-data or an
      RTL-SDR at 2 MS/s, show the pulses, and decode each message with the Mode S
      Decoder, an Embedded Python Block. To go live, disable the SigMF Source and
      the Throttle and enable the RTL-SDR Source. Receive only.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L18_adsb_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L18 - ADS-B Receiver
    window_size: (1060, 760)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
