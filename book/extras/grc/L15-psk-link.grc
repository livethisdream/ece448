options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L15: a line of ASCII text in packets over an RRC mPSK link (M =
      2, 4, or 8), with differential coding, through a channel with noise, frequency
      offset, phase, and clock error, then a matched filter, Symbol Sync, a Costas
      Loop, and a constellation decoder. Change M and run again; move the sliders
      until the text breaks.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L15_psk_link
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L15 - mPSK Link
    window_size: (1200,720)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: M
  id: variable
  parameters:
    comment: 2, 4, or 8
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 168]
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 8]
    rotation: 0
    state: enabled
- name: const
  id: variable
  parameters:
    comment: ''
    value: digital.constellation_calcdist(pts, list(range(M)), M, 1).base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 168]
    rotation: 0
    state: enabled
- name: costas_bw
