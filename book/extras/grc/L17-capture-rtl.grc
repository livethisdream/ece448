connections:
- [agc, '0', mag, '0']
- [mag, '0', env, '0']
- [rtl, '0', agc, '0']
- [rtl, '0', freq, '0']
- [rtl, '0', rec, '0']
- [rtl, '0', wf, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
