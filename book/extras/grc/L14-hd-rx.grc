- name: to_complex
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1016, 220]
    rotation: 0
    state: enabled
- name: to_float
  id: blocks_uchar_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 228]
    rotation: 0
    state: enabled

connections:
- [add_noise, '0', hd, '0']
- [file_source, '0', throttle, '0']
- [hd, '0', left, '0']
- [hd, '1', right, '0']
- [hd, '2', left, '1']
- [hd, '3', right, '1']
- [hd, '4', left, '2']
- [hd, '5', right, '2']
- [hd, '6', left, '3']
- [hd, '7', right, '3']
- [hd, files, art, files]
- [hd, id3, console, print]
- [hd, station, console, print]
- [left, '0', speaker, '0']
- [noise, '0', add_noise, '1']
- [pluto, '0', add_noise, '0']
- [recenter, '0', rescale, '0']
- [rescale, '0', split_iq, '0']
- [right, '0', speaker, '1']
- [split_iq, '0', to_complex, '0']
- [split_iq, '1', to_complex, '1']
- [throttle, '0', to_float, '0']
- [to_complex, '0', add_noise, '0']
- [to_float, '0', recenter, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
