options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L14: the spectrum, waterfall, and sideband power of an FM station
      with HD Radio, from L14-hd-test.cu8, an RTL-SDR capture at 1,488,375 samples
      per second, or the RTL-SDR live. Receive only.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L14_hd_find
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L14 - Finding the HD Radio Sidebands
    window_size: (1060,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: avg_len
  id: variable
  parameters:
    comment: ''
    value: int(0.2 * samp_rate / decim)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [968, 8]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: ''
    value: '6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 8]
    rotation: 0
    state: enabled
- name: df
  id: variable
  parameters:
    comment: ''
    value: 1488375 / 4096
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 8]
    rotation: 0
    state: enabled
- name: fc_mhz
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 0,0,1,1
    label: Center (MHz)
    type: real
    value: '100.3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1104, 8]
    rotation: 0
    state: enabled
- name: host_taps
  id: variable_low_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    cutoff_freq: 100e3
    gain: '1'
    samp_rate: samp_rate
    value: ''
    width: 10e3
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 80]
    rotation: 0
    state: enabled
- name: inner
  id: variable
  parameters:
    comment: ''
    value: '356'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 8]
    rotation: 0
    state: enabled
- name: iq_file
  id: variable
  parameters:
    comment: ''
    value: '''L14-hd-test.cu8'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 8]
    rotation: 0
    state: enabled
- name: outer
  id: variable
  parameters:
    comment: ''
    value: '546'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 8]
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,1,1,1
    label: RF gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '49.6'
    value: '30'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1248, 8]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '1488375'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: sb_center
  id: variable
  parameters:
    comment: ''
    value: (inner + outer) / 2 * df
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 8]
    rotation: 0
    state: enabled
- name: sb_half
  id: variable
  parameters:
    comment: ''
    value: ((outer - inner) / 2 + 0.5) * df
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [744, 8]
    rotation: 0
    state: enabled
- name: sb_taps
  id: variable_low_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    cutoff_freq: sb_half
    gain: '1'
    samp_rate: samp_rate
    value: ''
    width: 2e3
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 80]
    rotation: 0
    state: enabled
