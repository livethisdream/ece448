options:
  parameters:
    author: ECE 448
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'L16: the hopping FSK transmitter, a channel with noise, a path delay,
      and a narrowband jammer, and a receiver that finds the hop timing on the sync
      channel and de-hops. No hardware.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: L16_fhss_link
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: L16 - FHSS Link
    window_size: (1060,860)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

