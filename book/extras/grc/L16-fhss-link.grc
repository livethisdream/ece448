- name: hop_sync
  id: epy_block
  parameters:
    _source_code: "\"\"\"Hop Sync: the receiver's hop synthesizer. It multiplies the\
      \ received band\nby a tone that follows the same hop sequence as the transmitter,\
      \ so the\ntransmitted signal comes out at 0 Hz on every hop.\n\nSync on a known\
      \ hop: until it is locked, the block parks on the sync\nchannel, chan_f[seq[0]],\
      \ the channel of hop 0. The sequence uses each channel\nonce per cycle, so the\
      \ transmitter shows up there only on hop 0. When the\npower in the sync channel\
      \ jumps, hop 0 has started: the block takes that\nmoment as its hop boundary\
      \ and hops from then on, one hop every `dwell`\nsamples. Each received packet\
      \ arrives on the 'pkt' message port; if a full\ncycle and one more hop pass\
      \ with no packet, the block parks again.\n\noffset (hops) and timing_ms move\
      \ the receiver's hops away from the ones it\nfound, to show what a sync error\
      \ does. A Function Probe reads state().\"\"\"\n\nimport numpy as np\nimport\
      \ pmt\nfrom gnuradio import gr\nfrom gnuradio.filter import firdes\n\n\nclass\
      \ blk(gr.sync_block):\n    def __init__(self, samp_rate=128000, dwell=30720,\
      \ chan_f=[0.0], seq=[0], offset=0, timing_ms=0.0):\n        gr.sync_block.__init__(self,\
      \ name='Hop Sync', in_sig=[np.complex64], out_sig=[np.complex64])\n        self.message_port_register_in(pmt.intern('pkt'))\n\
      \        self.set_msg_handler(pmt.intern('pkt'), self.on_packet)\n        self.samp_rate\
      \ = samp_rate\n        self.dwell = int(dwell)\n        self.chan_f = list(chan_f)\n\
      \        self.seq = [int(c) for c in seq]\n        self.offset = offset\n  \
      \      self.timing_ms = timing_ms\n        self.taps = np.array(firdes.low_pass(1,\
      \ samp_rate, 2500, 2000), dtype=np.float32)\n        self.hist = np.zeros(len(self.taps)\
      \ - 1, dtype=np.complex64)\n        self.tick = 64                      # power\
      \ measured every 0.5 ms at 128 kHz\n        self.ticks = []                \
      \     # recent tick powers\n        self.part = np.zeros(0, dtype=np.float32)\n\
      \        self.ph_lo = 0.0                    # phase of the output tone\n  \
      \      self.ph_sync = 0.0                  # phase of the sync-channel detector\n\
      \        self.n_now = 0\n        self.locked = len(self.seq) == 1    # one channel:\
      \ nothing to find\n        self.b = 0                          # sample where\
      \ some hop 0 started\n        self.last_pkt = 0                   # hop count\
      \ of the last packet\n\n    def on_packet(self, msg):\n        if self.locked:\n\
      \            self.last_pkt = self.hop_count(self.n_now)\n\n    def hop_count(self,\
      \ n):\n        shift = int(round(self.timing_ms * 1e-3 * self.samp_rate))\n\
      \        return (n - self.b - shift) // self.dwell\n\n    def state(self):\n\
      \        if not self.locked:\n            return f'searching: parked on channel\
      \ {self.seq[0]}'\n        h = self.hop_count(self.n_now) + int(self.offset)\n\
      \        return f'locked: hop {h % len(self.seq)}, channel {self.seq[h % len(self.seq)]}'\n\
      \n    def detect(self, x, n0):\n        \"\"\"Return the sample where hop 0\
      \ began, or None.\"\"\"\n        n = np.arange(len(x))\n        w = 2 * np.pi\
      \ * self.chan_f[self.seq[0]] / self.samp_rate\n        y = x * np.exp(-1j *\
      \ (self.ph_sync + w * n)).astype(np.complex64)\n        self.ph_sync = (self.ph_sync\
      \ + w * len(x)) % (2 * np.pi)\n        z = np.convolve(np.concatenate([self.hist,\
      \ y]), self.taps, mode='valid')\n        self.hist = np.concatenate([self.hist,\
      \ y])[-(len(self.taps) - 1):]\n        p = np.concatenate([self.part, np.abs(z)\
      \ ** 2])\n        k = len(p) // self.tick\n        first = n0 + len(x) - len(p)\
      \        # sample index of p[0]\n        self.part = p[k * self.tick:]\n   \
      \     found = None\n        for i in range(k):\n            self.ticks.append(p[i\
      \ * self.tick:(i + 1) * self.tick].mean())\n            t = self.ticks\n   \
      \         if len(t) < 48 or found is not None:\n                continue\n \
      \           now = np.mean(t[-4:])                # last 2 ms\n            ref\
      \ = np.mean(t[-44:-8])             # 18 ms, ending 4 ms ago\n            if\
      \ now > 4 * ref + 1e-9:\n                j = len(t) - 8 + int(np.argmax(np.array(t[-8:])\
      \ > now / 2))\n                back = len(t) - 1 - j            # ticks before\
      \ this one\n                found = first + (i - back) * self.tick - (len(self.taps)\
      \ - 1) // 2\n        del self.ticks[:-64]\n        return found\n\n    def work(self,\
      \ input_items, output_items):\n        x = input_items[0]\n        n0 = self.nitems_read(0)\n\
      \        self.n_now = n0 + len(x)\n        b = self.detect(x, n0)\n        if\
      \ not self.locked and b is not None:\n            self.locked, self.b = True,\
      \ b\n            self.last_pkt = 0\n        nch = len(self.seq)\n        if\
      \ self.locked and nch > 1 and self.hop_count(self.n_now) - self.last_pkt > nch\
      \ + 1:\n            self.locked = False\n        n = n0 + np.arange(len(x))\n\
      \        if self.locked:\n            h = self.hop_count(n) + int(self.offset)\n\
      \            f = np.array(self.chan_f)[np.array(self.seq)[h % nch]]\n      \
      \  else:\n            f = np.full(len(x), self.chan_f[self.seq[0]])\n      \
      \  dph = 2 * np.pi * f / self.samp_rate\n        ph = self.ph_lo + np.cumsum(dph)\
      \ - dph\n        self.ph_lo = float((ph[-1] + dph[-1]) % (2 * np.pi)) if len(x)\
      \ else self.ph_lo\n        output_items[0][:] = x * np.exp(-1j * ph).astype(np.complex64)\n\
      \        return len(x)\n"
    affinity: ''
    alias: ''
    chan_f: chan_f
    comment: ''
    dwell: dwell
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: offset
    samp_rate: samp_rate
    seq: rx_seq
    timing_ms: timing_ms
  states:
    _io_cache: ('Hop Sync', 'blk', [('samp_rate', '128000'), ('dwell', '30720'), ('chan_f',
      '[0.0]'), ('seq', '[0]'), ('offset', '0'), ('timing_ms', '0.0')], [('0', 'complex',
      1), ('pkt', 'message', 1)], [('0', 'complex', 1)], '', ['chan_f', 'dwell', 'offset',
      'samp_rate', 'seq', 'timing_ms'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 980
    state: enabled
