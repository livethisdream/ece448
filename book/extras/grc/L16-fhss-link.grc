- name: text_sink
  id: epy_block
  parameters:
    _source_code: "\"\"\"Text Sink: shows each received packet as a line of text,\
      \ counts the lines\nthat match the transmitted message, and compares that count\
      \ with the number\nof hops the transmitter has sent, one packet per hop. The\
      \ counts restart\nwhenever a slider moves, because GRC sets `settings` each\
      \ time one changes.\nEvery packet also goes out the 'pkt' port, which tells\
      \ Hop Sync that it is\nstill on the right hops. Function Probes read last_line()\
      \ and stats().\"\"\"\n\nimport time\n\nimport numpy as np\nimport pmt\nfrom\
      \ gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\
      \ expected='', hop_rate=1.0, settings=None):\n        gr.sync_block.__init__(self,\
      \ name='Text Sink', in_sig=[np.uint8], out_sig=None)\n        self.message_port_register_out(pmt.intern('pkt'))\n\
      \        self.expected = expected\n        self.hop_rate = hop_rate\n      \
      \  self.key = pmt.intern('packet_len')\n        self.buf = ''\n        self.need\
      \ = 0\n        self.line = '(waiting for a packet)'\n        self.settings =\
      \ settings\n\n    @property\n    def settings(self):\n        return self._settings\n\
      \n    @settings.setter\n    def settings(self, value):\n        self._settings\
      \ = value\n        self.good = 0\n        self.total = 0\n        self.t0 =\
      \ time.monotonic()\n\n    def work(self, input_items, output_items):\n     \
      \   data = input_items[0]\n        start = self.nitems_read(0)\n        # Each\
      \ packet starts with a packet_len tag, so a corrupted newline\n        # cannot\
      \ run two packets together.\n        # Each packet starts with a packet_len\
      \ tag that holds its length, so\n        # the line ends after that many bytes,\
      \ even if its newline is wrong.\n        tags = {t.offset - start: pmt.to_long(t.value)\n\
      \                for t in self.get_tags_in_window(0, 0, len(data), self.key)}\n\
      \        for i, b in enumerate(data):\n            if i in tags:\n         \
      \       if self.buf:\n                    self.finish()\n                self.need\
      \ = tags[i]\n            self.buf += chr(b) if 32 <= b < 127 or b == 10 else\
      \ '?'\n            if len(self.buf) == self.need:\n                self.finish()\n\
      \        return len(data)\n\n    def finish(self):\n        self.line = self.buf[:-1]\
      \ if self.buf.endswith('\\n') else self.buf\n        self.total += 1\n     \
      \   self.good += self.buf == self.expected + '\\n'\n        self.buf = ''\n\
      \        self.message_port_pub(pmt.intern('pkt'), pmt.PMT_T)\n\n    def last_line(self):\n\
      \        return self.line\n\n    def stats(self):\n        t = time.monotonic()\
      \ - self.t0\n        sent = int(t * self.hop_rate)\n        pct = f' ({100 *\
      \ self.good / sent:.0f}%)' if sent else ''\n        return f'{self.good} correct\
      \ of {sent} sent in {t:.0f} s{pct}'\n"
    affinity: ''
    alias: ''
    comment: ''
    expected: msg
    hop_rate: samp_rate/dwell
    maxoutbuf: '0'
    minoutbuf: '0'
    settings: (jam_amp, jam_ch, offset, timing_ms) + extra
  states:
    _io_cache: ('Text Sink', 'blk', [('expected', "''"), ('hop_rate', '1.0'), ('settings',
      'None')], [('0', 'byte', 1)], [('pkt', 'message', 1)], '', ['expected', 'hop_rate',
      'settings'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1840
    - 1010
    state: enabled
